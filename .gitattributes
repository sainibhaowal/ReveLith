# Normalize line endings: everything text is committed with LF and checked
# out as LF on every platform, so Windows clones (core.autocrlf=true) don't
# fail the incremental prettier --check CI gate on CRLF.
* text=auto eol=lf

# Binary assets — never normalized or diffed as text.
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Office metafiles: binary VBA-era formats. Without this, text=auto EOL
# normalization corrupts embedded 0D 0A bytes on commit (and the sync script
# below must also treat them as binary — see tools/sync-genoffice-to-revelith.mjs).
*.emf binary
*.wmf binary
*.emz binary
*.wmz binary
# Legacy Office binaries (OLE CFBF): same text-mangling hazard as above.
*.doc binary
*.ppt binary
*.xls binary
*.dot binary
*.pot binary
*.pps binary
*.xla binary
