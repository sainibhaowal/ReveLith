{
  "name": "@revelith/forms-builder",
  "productName": "ReveLith Forms Builder",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native form builder for surveys, quizzes, and data collection",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build \u0026\u0026 electron-builder --mac",
    "dist:win": "electron-vite build \u0026\u0026 electron-builder --win",
    "dist:dir": "electron-vite build \u0026\u0026 electron-builder --dir"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ReveLith",
  "build": {
    "appId": "com.revelith.forms-builder",
    "productName": "ReveLith Forms Builder",
    "electronVersion": "43.3.0",
    "artifactName": "AIForms-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "form",
        "name": "ReveLith Form",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@revelith/agent-core": "*",
    "@revelith/ai-provider": "*",
    "@revelith/app-chat": "*",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1"
  }
}
