{
  "name": "@revelith/shell",
  "productName": "ReveLith",
  "version": "1.1.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sainibhaowal/ReveLith.git"
  },
  "homepage": "https://github.com/sainibhaowal/ReveLith",
  "private": true,
  "description": "Unified Revelith shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "revelith.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@revelith/agent-core": "*",
    "@revelith/ai-provider": "*",
    "@revelith/ai-search": "*",
    "@revelith/docs": "*",
    "@revelith/docx-engine": "*",
    "@revelith/electron-utils": "*",
    "@revelith/i18n": "*",
    "@revelith/pptx-engine": "*",
    "@revelith/pptx-render": "*",
    "@revelith/sheets": "*",
    "@revelith/slides": "*",
    "@revelith/ui": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "author": "Revelith"
}
