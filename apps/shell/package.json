{
  "name": "@revelith/shell",
  "productName": "ReveLith",
  "version": "0.10.100",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sainibhaowal/ReveLith",
  "private": true,
  "description": "Unified ReveLith shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "revelith.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@revelith/agent-core": "*",
    "@revelith/ai-provider": "*",
    "@revelith/ai-search": "*",
    "@revelith/file-parse": "*",
    "@revelith/docs": "*",
    "@revelith/docx-engine": "*",
    "@revelith/electron-utils": "*",
    "@revelith/cli": "*",
    "@revelith/i18n": "*",
    "@revelith/pipelines": "*",
    "@revelith/pptx-engine": "*",
    "@revelith/pptx-render": "*",
    "@revelith/sheets": "*",
    "@revelith/slides": "*",
    "@revelith/ui": "*",
    "@revelith/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ReveLith"
}
