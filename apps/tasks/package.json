{
  "name": "@revelith/tasks",
  "productName": "ReveLith Tasks",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "AI-native task and project management with kanban boards",
  "main": "out/main/index.js",
  "bin": {
    "revelith-tasks": "./out/cli/index.js",
    "revelith-tasks-mcp": "./out/cli/mcp.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build": "node ../../tools/run-with-local-temp.mjs electron-vite build && node scripts/build-cli.mjs",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/cli/mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.11",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ReveLith",
  "build": {
    "appId": "com.revelith.tasks",
    "productName": "ReveLith Tasks",
    "electronVersion": "43.3.0",
    "artifactName": "AITasks-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [
      {
        "ext": "task",
        "name": "ReveLith Task",
        "role": "Editor"
      },
      {
        "ext": "project",
        "name": "ReveLith Project",
        "role": "Editor"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@revelith/agent-core": "*",
    "@revelith/ai-provider": "*",
    "@revelith/app-chat": "*",
    "@revelith/ui": "*",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.5"
  }
}
